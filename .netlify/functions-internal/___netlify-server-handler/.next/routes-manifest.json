      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/evenements",
      "regex": "^/evenements(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/evenements(?:/)?$"
    },
    {
      "page": "/evenements/presence",
      "regex": "^/evenements/presence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/evenements/presence(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/gouvernance",
      "regex": "^/gouvernance(?:/)?$",
