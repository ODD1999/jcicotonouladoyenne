      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/a-propos",
      "regex": "^/a\\-propos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/a\\-propos(?:/)?$"
    },
    {
      "page": "/actualites",
      "regex": "^/actualites(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/actualites(?:/)?$"
    },
    {
      "page": "/api/presence",
      "regex": "^/api/presence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/presence(?:/)?$"
    },
    {
      "page": "/api/presence/export",
      "regex": "^/api/presence/export(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/presence/export(?:/)?$"
    },
    {
      "page": "/connexion",
      "regex": "^/connexion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/connexion(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
